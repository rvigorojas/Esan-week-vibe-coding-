# Copiar a .env (no versionado) y ajustar en local.
DATABASE_URL=postgresql+asyncpg://pce:pce@localhost:5432/pce
JWT_SECRET=cambiar-en-produccion
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
# Ventana maxima de sesion offline con token vencido (token blando, ADR-7). Un turno operativo.
JWT_SOFT_TOKEN_GRACE_HOURS=12
